[Unit]
Description=Keep Yuga running as a server independently of display power
After=local-fs.target
Before=repowerd.service

[Service]
Type=oneshot
ExecStart=/bin/sh -ec 'echo yuga-server-awake > /sys/power/wake_lock; echo off > /sys/power/autosleep'
ExecStop=/bin/sh -ec 'echo yuga-server-awake > /sys/power/wake_unlock'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
