-		pi->mps    = le16_to_cpu(rfc.max_pdu_size);
-		if (pi->extended_control)
-			pi->ack_win = min_t(u16, pi->ack_win, txwin_ext);
-		else
-			pi->ack_win = min_t(u16, pi->ack_win, rfc.txwin_size);
