[Unit]
Description=Initialize independent Yuga SSH identity after persistent mounts
RequiresMountsFor=/userdata /root /etc/ssh
After=local-fs.target
Before=ssh.service

[Service]
Type=oneshot
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 /usr/lib/yuga-firstboot/yuga_firstboot.py
RemainAfterExit=yes
